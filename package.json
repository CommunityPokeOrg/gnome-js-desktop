{
  "name": "gnome-js-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GNOME-style desktop environment prototype in the browser with cross-KWin window synchronization",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bridge": "python3 bridge/kwin_sync_bridge.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.6.0",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
